# Copiar a .env (nunca subir .env al repositorio)
POSTGRES_DB=asesor
POSTGRES_USER=asesor
POSTGRES_PASSWORD=cambia-esta-clave
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
CORS_ORIGINS=["http://localhost"]
WEB_PORT=80

# Administrador inicial (se crea solo si la base de datos no tiene usuarios)
ADMIN_CORREO=admin@asesor.local
ADMIN_CONTRASENA=cambia-esta-clave-admin

# Proveedor de IA: "claude" (nube) u "ollama" (local)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434

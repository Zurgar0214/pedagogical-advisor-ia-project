# Copiar a .env (nunca subir .env al repositorio)
POSTGRES_DB=asesor
POSTGRES_USER=asesor
POSTGRES_PASSWORD=cambia-esta-clave
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
CORS_ORIGINS=["http://localhost"]
WEB_PORT=80

# Administrador inicial (se crea solo si la base de datos no tiene usuarios)
ADMIN_CORREO=admin@asesor.local
ADMIN_CONTRASENA=cambia-esta-clave-admin

# Proveedor de IA: "claude" (nube), "ollama" (local) o "falso" (demo determinista sin clave)
AI_PROVIDER=falso
ANTHROPIC_API_KEY=
IA_MODELO_PRINCIPAL=claude-haiku-5-5
IA_MODELO_ESCALAMIENTO=claude-sonnet-5-5
IA_UMBRAL_CONFIANZA=0.6
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODELO=qwen2.5-coder:7b
# Contexto de Ollama en tokens; con modelos locales conviene IA_MAX_CARACTERES_CONTEXTO=40000
OLLAMA_NUM_CTX=16384

# Token compartido entre la API y el servicio sandbox (ejecución aislada de pruebas del estudiante).
# Usa un valor largo y aleatorio; si queda vacío el servicio sandbox rechaza todo.
SANDBOX_TOKEN=cambia-esto-por-un-token-largo
